{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "_Comment": "This is the normal log Connection string",
    "ApiLoggerDb": "Data Source=YourServer;Initial Catalog=ServeLoggerDb;User ID=UserDb1;Password=PasswordDb",
    "_Comment1": "This is the internal log Connection string, can be the same",
    "InternalLoggerDb": "Data Source=YourServer;Initial Catalog=ServeLoggerDb;User ID=UserDb2;Password=PasswordDb"
  },
  "LoggerService": {
    "Tables": {
      "TESTTOKEN": "TestLog",
      "YOURTOKEN": "YourTableLog"
    },
    "LogSettings": {
      "UseInternalDateTime": "true",
      "InternalTime": "Eastern Standard Time",
      "TaskCancellationTimeMs": "60000"
    },
    "InternalLogSettings": {
      "Table": "ServeLog",
      "LogLevel": "DEBUG",
      "TimeZone": "UTC"
    },
    "Cors": {
      "AllowdOrigin": [ "*" ],
      "ActivePolicy": "OpenPolicy"
    }
  }
}
